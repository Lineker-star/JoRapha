# Variable NAMES only — public values, no secrets. Copy to apps/web/.env.local (never committed).
# Local stack: values from `pnpm supabase status`. Hosted dev: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key. NEVER the service_role / secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public origin used in e-mail links (magic link, password reset); optional, defaults to the request host.
NEXT_PUBLIC_SITE_URL=
