# Variable NAMES only. Copy to apps/patient/.env.local (never committed); for EAS builds set them as EAS
# environment variables. EXPO_PUBLIC_* values are bundled into the app: public values only, never the
# service_role / secret key.
EXPO_PUBLIC_SUPABASE_URL=
# The publishable key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
