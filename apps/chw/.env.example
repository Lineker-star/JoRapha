# Variable NAMES only — public values, no secrets. Copy to apps/chw/.env.local (never committed) for local
# builds; for EAS cloud builds set them as EAS environment variables (environment "development").
EXPO_PUBLIC_SUPABASE_URL=
# The publishable (anon) key. NEVER the service_role key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# PowerSync Cloud instance URL (Instance → Connect).
EXPO_PUBLIC_POWERSYNC_URL=
# The EAS project id is public and lives in app.config.ts (extra.eas.projectId).
