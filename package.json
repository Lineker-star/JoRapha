{
  "name": "jorapha",
  "private": true,
  "description": "JoRapha â€” hybrid digital-health platform for East, Adamawa and North Cameroon",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "node packages/db-types/scripts/generate.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --schema public,identity,patient,provider,scheduling,clinical,referral,lab,pharmacy,community,billing,content,audit,sync --level warning --fail-on error",
    "db:test": "supabase test db",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "lefthook": "2.2.2",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "supabase": "3.2.0",
    "turbo": "2.11.12",
    "typescript": "6.0.3"
  }
}
