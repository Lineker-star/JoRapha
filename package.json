{
  "name": "jorapha",
  "private": true,
  "description": "JoRapha — hybrid digital-health platform for East, Adamawa and North Cameroon",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "node packages/db-types/scripts/generate.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --level warning",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "supabase": "3.3.0",
    "turbo": "2.11.13",
    "typescript": "6.0.3"
  }
}
